# syntax=docker/dockerfile:1.7

# Build this as a thin extension of the current RPX paper image. The immutable
# cumulative image remains a usable fallback when BASE_IMAGE is not supplied.
ARG BASE_IMAGE=narendhiranv04/rpx-depth-smoke@sha256:3b86de0e4e136587d6ea7d816a482af15cb115dc6a14f16ea8f7d9356ab220cc
FROM ${BASE_IMAGE}

ARG RPX_GIT_SHA
ARG FE2E_SHA=262d4c9d4c37752c984304f57ca7d7066f34ad5d

LABEL org.opencontainers.image.title="RPX official FE2E depth runtime" \
      org.opencontainers.image.source="https://github.com/IRVLUTD/RPX" \
      org.opencontainers.image.revision="${RPX_GIT_SHA}" \
      org.opencontainers.image.fe2e.revision="${FE2E_SHA}"

ENV RPX_GIT_SHA=${RPX_GIT_SHA} \
    RPX_FE2E_SOURCE=/opt/rpx-envs/sources/fe2e \
    HF_HOME=/cache/huggingface \
    CC=/usr/bin/gcc \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY benchmark /opt/rpx/benchmark
COPY docker/depth-fe2e/requirements-fe2e.lock /tmp/requirements-fe2e.lock

# Triton compiles its CUDA driver helper on the first real GPU forward. Keep a
# C toolchain in the runtime image; import-only validation does not trigger it.
RUN apt-get update && \
    apt-get install --yes --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/* && \
    test -x "${CC}"

# Pin the paper-authors' official release, including the checked-in empty-prompt
# latent used by their one-step inference path.
RUN test -n "${RPX_GIT_SHA}" && \
    mkdir -p /opt/rpx-envs/sources && \
    git init "${RPX_FE2E_SOURCE}" && \
    git -C "${RPX_FE2E_SOURCE}" remote add origin https://github.com/AMAP-ML/FE2E.git && \
    git -C "${RPX_FE2E_SOURCE}" fetch --depth 1 origin "${FE2E_SHA}" && \
    git -C "${RPX_FE2E_SOURCE}" checkout --detach FETCH_HEAD && \
    test "$(git -C "${RPX_FE2E_SOURCE}" rev-parse HEAD)" = "${FE2E_SHA}" && \
    echo "f03d72f486f1cefc0bcd6d21d420156cb3e96ec9d701af667386bbd2eedbafa2  ${RPX_FE2E_SOURCE}/latent/no_info.npz" | sha256sum -c -

# FE2E's released environment uses PyTorch 2.6/CUDA 12.4. Keep it isolated
# from the cumulative image's PyTorch 2.10 runtime. The flash-attn wheel name
# is the one generated by FE2E's own scripts/get_flash_attn.py for this ABI.
RUN python -m venv /opt/rpx-envs/fe2e && \
    /opt/rpx-envs/fe2e/bin/python -m pip install --upgrade pip==25.3 setuptools wheel && \
    /opt/rpx-envs/fe2e/bin/python -m pip install \
      --index-url https://download.pytorch.org/whl/cu124 \
      torch==2.6.0 torchvision==0.21.0 && \
    /opt/rpx-envs/fe2e/bin/python -m pip install -r /tmp/requirements-fe2e.lock && \
    /opt/rpx-envs/fe2e/bin/python -m pip install --no-deps \
      "https://github.com/Dao-AILab/flash-attention/releases/download/v2.7.2.post1/flash_attn-2.7.2.post1%2Bcu12torch2.6cxx11abiFALSE-cp311-cp311-linux_x86_64.whl" && \
    /opt/rpx-envs/fe2e/bin/python -m pip install --no-deps --force-reinstall /opt/rpx/benchmark && \
    /opt/rpx-envs/fe2e/bin/python -c \
      "import pathlib,site; pathlib.Path(site.getsitepackages()[0], 'rpx-fe2e-source.pth').write_text('/opt/rpx-envs/sources/fe2e\n/opt/rpx/benchmark/scripts\n')"

RUN /opt/rpx-envs/fe2e/bin/python -c \
      "import flash_attn,numpy,pyarrow,scipy,torch; from infer.inference import ImageGenerator; from depth_models.fe2e import FE2EAdapter; assert torch.__version__.startswith('2.6.0'); assert FE2EAdapter.UPSTREAM_REVISION == '${FE2E_SHA}'; print('official FE2E imports ready', torch.__version__, torch.version.cuda)" && \
    /opt/rpx-envs/fe2e/bin/python -m pip freeze > /opt/rpx-envs/fe2e/pip-freeze.txt && \
    /opt/rpx-envs/fe2e/bin/python -c \
      "import json,pathlib,sys; pathlib.Path('/opt/rpx-envs/fe2e/rpx-environment.json').write_text(json.dumps({'container': True, 'family': 'fe2e', 'models': ['fe2e'], 'python': sys.executable, 'rpx_git_sha': '${RPX_GIT_SHA}', 'upstream_revision': '${FE2E_SHA}', 'checkpoint_repo': 'exander/FE2E', 'checkpoint_revision': '4c52e5e3d133e4111f6099b57879d517dd8677b8'}, indent=2)+'\n')"

WORKDIR /opt/rpx/benchmark
VOLUME ["/cache/huggingface", "/outputs"]
ENTRYPOINT []
CMD ["/opt/rpx-envs/fe2e/bin/python", "scripts/run_depth.py", "--help"]
