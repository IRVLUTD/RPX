# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG PI3X_GIT_SHA=9fa3ddb3f8d53041f8b2738df404f62223bbaa7b
ARG PI3X_HF_REVISION=bb1deea4d7423de5b30691739cb451a3f57dc1d5
ARG PI3X_CONFIG_SHA256=0e7d23382f8dc98b6eb15c546a5cb6bfe0021e290d43d72adb0842d57b031967
ARG PI3X_WEIGHTS_SHA256=69972d6e1c4492cb4d737a84fe940e357087d81c52f5c9b7c160b49c1f41669a
ARG PI3X_WEIGHTS_BYTES=5440325620

COPY docker/rcpe-smoke/requirements-pi3x.lock /tmp/requirements-pi3x.lock

RUN test -n "${PI3X_GIT_SHA}" && \
    mkdir -p /opt/rpx-models && \
    git init /opt/rpx-models/pi3x && \
    git -C /opt/rpx-models/pi3x remote add origin https://github.com/yyfz/Pi3.git && \
    git -C /opt/rpx-models/pi3x fetch --depth 1 origin "${PI3X_GIT_SHA}" && \
    git -C /opt/rpx-models/pi3x checkout --detach FETCH_HEAD && \
    test -f /opt/rpx-models/pi3x/pi3/models/pi3x.py

RUN python -m venv --system-site-packages /opt/rpx-envs/pi3x && \
    /opt/rpx-envs/pi3x/bin/python -m pip install --upgrade pip==25.3 && \
    /opt/rpx-envs/pi3x/bin/python -m pip install -r /tmp/requirements-pi3x.lock

RUN mkdir -p /opt/rpx-models/pi3x/checkpoints/Pi3X && \
    curl --fail --location --retry 5 --retry-all-errors \
      "https://huggingface.co/yyfz233/Pi3X/resolve/${PI3X_HF_REVISION}/config.json" \
      --output /opt/rpx-models/pi3x/checkpoints/Pi3X/config.json && \
    curl --fail --location --retry 5 --retry-all-errors \
      "https://huggingface.co/yyfz233/Pi3X/resolve/${PI3X_HF_REVISION}/model.safetensors" \
      --output /opt/rpx-models/pi3x/checkpoints/Pi3X/model.safetensors && \
    echo "${PI3X_CONFIG_SHA256}  /opt/rpx-models/pi3x/checkpoints/Pi3X/config.json" | sha256sum --check --strict && \
    echo "${PI3X_WEIGHTS_SHA256}  /opt/rpx-models/pi3x/checkpoints/Pi3X/model.safetensors" | sha256sum --check --strict && \
    test "$(stat -c %s /opt/rpx-models/pi3x/checkpoints/Pi3X/model.safetensors)" -eq "${PI3X_WEIGHTS_BYTES}"

ARG RPX_GIT_SHA

LABEL org.opencontainers.image.title="RPX cumulative RCPE runtime through Pi3X" \
      org.opencontainers.image.revision="${RPX_GIT_SHA}"

ENV RPX_GIT_SHA=${RPX_GIT_SHA} PYTHONUNBUFFERED=1 HF_HOME=/cache/huggingface

COPY benchmark /opt/rpx/benchmark

RUN test -n "${RPX_GIT_SHA}" && \
    /opt/rpx-envs/pi3x/bin/python -m pip install --no-deps --force-reinstall /opt/rpx/benchmark && \
    PYTHONPATH=/opt/rpx-models/pi3x:/opt/rpx/benchmark/scripts \
      /opt/rpx-envs/pi3x/bin/python -c \
      "import numpy,omegaconf,pandas,plyfile,pyarrow,torch,torchvision; from pi3.models.pi3x import Pi3X; from pose_models import MODEL_REGISTRY; assert numpy.__version__ == '1.26.4'; assert torch.__version__.startswith('2.5.1'); assert torchvision.__version__.startswith('0.20.1'); assert 'pi3x' in MODEL_REGISTRY; model=Pi3X.from_pretrained('/opt/rpx-models/pi3x/checkpoints/Pi3X'); model.disable_multimodal(free_cuda_cache=False); assert model is not None; del model; print(f'Pi3X RCPE environment: OK (torch={torch.__version__}, torchvision={torchvision.__version__})')" && \
    /opt/rpx-envs/pi3x/bin/python -m pip freeze > /opt/rpx-envs/pi3x/rpx-pip-freeze.txt && \
    /opt/rpx-envs/pi3x/bin/python -c \
      "import json,pathlib,sys; pathlib.Path('/opt/rpx-envs/pi3x/rpx-environment.json').write_text(json.dumps({'container': True, 'model': 'pi3x', 'checkpoint': 'yyfz233/Pi3X', 'checkpoint_revision': '${PI3X_HF_REVISION}', 'checkpoint_sha256': '${PI3X_WEIGHTS_SHA256}', 'translation_scale': 'approximate-metric', 'native_pose': 'opencv-camera-to-world', 'python': sys.executable, 'rpx_git_sha': '${RPX_GIT_SHA}', 'source_revision': '${PI3X_GIT_SHA}'}, indent=2)+'\n')"

WORKDIR /opt/rpx/benchmark
VOLUME ["/cache/huggingface", "/outputs"]
ENTRYPOINT []
CMD ["/bin/bash"]
