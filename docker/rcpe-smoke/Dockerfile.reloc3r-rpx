# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG RELOC3R_GIT_SHA=761fac648e9c21fd7dcda01ab2ccd4fc20058102
ARG CROCO_GIT_SHA=e348fec08cf70060053d002226f03bbfc83d2089
ARG RELOC3R_HF_REVISION=55014aae1798ec830df51d7d2cd47c41f4388187
ARG RELOC3R_CONFIG_SHA256=e2b98b1473c6d9ca178b47fe9d8ef02449268ee57ca6af748596600289b06021
ARG RELOC3R_WEIGHTS_SHA256=d02f5f4d749c926195981fbd8de7f78009a72f9a1d3b9b8708dd9794bf5455c1
ARG RELOC3R_WEIGHTS_BYTES=1706156328

COPY docker/rcpe-smoke/requirements-reloc3r.lock /tmp/requirements-reloc3r.lock

RUN test -n "${RELOC3R_GIT_SHA}" && \
    mkdir -p /opt/rpx-models && \
    git init /opt/rpx-models/reloc3r && \
    git -C /opt/rpx-models/reloc3r remote add origin https://github.com/ffrivera0/reloc3r.git && \
    git -C /opt/rpx-models/reloc3r fetch --depth 1 origin "${RELOC3R_GIT_SHA}" && \
    git -C /opt/rpx-models/reloc3r checkout --detach FETCH_HEAD && \
    git -C /opt/rpx-models/reloc3r submodule update --init --recursive --depth 1 && \
    test "$(git -C /opt/rpx-models/reloc3r/croco rev-parse HEAD)" = "${CROCO_GIT_SHA}" && \
    test -d /opt/rpx-models/reloc3r/croco/models

RUN python -m venv --system-site-packages /opt/rpx-envs/reloc3r && \
    /opt/rpx-envs/reloc3r/bin/python -m pip install --upgrade pip==25.3 && \
    /opt/rpx-envs/reloc3r/bin/python -m pip install -r /tmp/requirements-reloc3r.lock

RUN mkdir -p /opt/rpx-models/reloc3r/checkpoints/reloc3r-512 && \
    curl --fail --location --retry 5 --retry-all-errors \
      "https://huggingface.co/siyan824/reloc3r-512/resolve/${RELOC3R_HF_REVISION}/config.json" \
      --output /opt/rpx-models/reloc3r/checkpoints/reloc3r-512/config.json && \
    curl --fail --location --retry 5 --retry-all-errors \
      "https://huggingface.co/siyan824/reloc3r-512/resolve/${RELOC3R_HF_REVISION}/model.safetensors" \
      --output /opt/rpx-models/reloc3r/checkpoints/reloc3r-512/model.safetensors && \
    echo "${RELOC3R_CONFIG_SHA256}  /opt/rpx-models/reloc3r/checkpoints/reloc3r-512/config.json" | sha256sum --check --strict && \
    echo "${RELOC3R_WEIGHTS_SHA256}  /opt/rpx-models/reloc3r/checkpoints/reloc3r-512/model.safetensors" | sha256sum --check --strict && \
    test "$(stat -c %s /opt/rpx-models/reloc3r/checkpoints/reloc3r-512/model.safetensors)" -eq "${RELOC3R_WEIGHTS_BYTES}"

ARG RPX_GIT_SHA

LABEL org.opencontainers.image.title="RPX cumulative RCPE runtime through Reloc3r" \
      org.opencontainers.image.source="https://github.com/IRVLUTD/RPX" \
      org.opencontainers.image.revision="${RPX_GIT_SHA}"

ENV RPX_GIT_SHA=${RPX_GIT_SHA} PYTHONUNBUFFERED=1 HF_HOME=/cache/huggingface

COPY benchmark /opt/rpx/benchmark

RUN test -n "${RPX_GIT_SHA}" && \
    /opt/rpx-envs/reloc3r/bin/python -m pip install --no-deps --force-reinstall /opt/rpx/benchmark && \
    PYTHONPATH=/opt/rpx-models/reloc3r:/opt/rpx/benchmark/scripts \
      /opt/rpx-envs/reloc3r/bin/python -c \
      "import numpy,pandas,pyarrow,roma,scipy,torch,torchvision; from reloc3r.reloc3r_relpose import Reloc3rRelpose,inference_relpose; from pose_models import MODEL_REGISTRY; assert numpy.__version__ == '1.26.4'; assert 'reloc3r' in MODEL_REGISTRY; model=Reloc3rRelpose.from_pretrained('/opt/rpx-models/reloc3r/checkpoints/reloc3r-512'); assert model is not None; del model; print(f'Reloc3r RCPE environment: OK (torch={torch.__version__}, torchvision={torchvision.__version__})')" && \
    /opt/rpx-envs/reloc3r/bin/python -m pip freeze > /opt/rpx-envs/reloc3r/rpx-pip-freeze.txt && \
    /opt/rpx-envs/reloc3r/bin/python -c \
      "import json,pathlib,sys; pathlib.Path('/opt/rpx-envs/reloc3r/rpx-environment.json').write_text(json.dumps({'container': True, 'model': 'reloc3r', 'checkpoint': 'siyan824/reloc3r-512', 'checkpoint_revision': '${RELOC3R_HF_REVISION}', 'translation_scale': 'unit', 'native_pose': 'pose2to1', 'python': sys.executable, 'rpx_git_sha': '${RPX_GIT_SHA}', 'source_revision': '${RELOC3R_GIT_SHA}', 'croco_revision': '${CROCO_GIT_SHA}'}, indent=2)+'\\n')"

WORKDIR /opt/rpx/benchmark
VOLUME ["/cache/huggingface", "/outputs"]
ENTRYPOINT []
CMD ["/bin/bash"]
