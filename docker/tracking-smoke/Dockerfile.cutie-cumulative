# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG RPX_GIT_SHA

LABEL org.opencontainers.image.source="https://github.com/IRVLUTD/RPX" \
      org.opencontainers.image.revision="${RPX_GIT_SHA}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      org.opencontainers.image.description="Cumulative RPX D3 SAM2, EdgeTAM and Cutie image"

ENV RPX_GIT_SHA=${RPX_GIT_SHA} \
    RPX_TRACKING_PYTHON=/opt/rpx-envs/cutie/bin/python \
    PYTHONUNBUFFERED=1

COPY --chmod=0755 docker/tracking-smoke/register_model_env.py /usr/local/bin/rpx-register-model-env
COPY --chmod=0755 docker/tracking-smoke/stamp_adapter_env.py /usr/local/bin/rpx-stamp-adapter-env

ARG CUTIE_GIT_SHA=ec5cdd4cf16f75c73ad785a2f96fb97dbad4125a
ARG THINPLATE_GIT_SHA=f6995795397118b7d0ac01aecd3f39ffbfad9dee
RUN test "${#RPX_GIT_SHA}" -eq 40 && \
    case "${RPX_GIT_SHA}" in \
      *[!0-9a-f]*) echo "RPX_GIT_SHA must be lowercase hexadecimal" >&2; exit 1 ;; \
      *) ;; \
    esac && \
    rpx-clone-pinned https://github.com/hkchengrex/Cutie.git \
      "${CUTIE_GIT_SHA}" /opt/rpx-models/cutie && \
    rpx-clone-pinned https://github.com/cheind/py-thin-plate-spline.git \
      "${THINPLATE_GIT_SHA}" /opt/rpx-models/thinplate && \
    python -m venv --system-site-packages /opt/rpx-envs/cutie && \
    /opt/rpx-envs/cutie/bin/python -m pip install \
      --no-deps --no-build-isolation /opt/rpx-models/thinplate && \
    /opt/rpx-envs/cutie/bin/python -m pip install \
      --no-deps --no-build-isolation /opt/rpx-models/cutie && \
    /opt/rpx-envs/cutie/bin/python /usr/local/bin/rpx-register-model-env \
      --model cutie \
      --prompt mask \
      --source-dir /opt/rpx-models/cutie \
      --source-revision "${CUTIE_GIT_SHA}" \
      --checkpoint-repo hkchengrex/Cutie \
      --checkpoint-revision v1.0 \
      --import cutie \
      --import cutie.inference.inference_core

COPY benchmark /opt/rpx/benchmark

RUN /opt/rpx-envs/cutie/bin/python -m pip install \
      --no-deps --force-reinstall /opt/rpx/benchmark && \
    /opt/rpx-envs/cutie/bin/python /usr/local/bin/rpx-stamp-adapter-env \
      --model cutie \
      --source-revision ec5cdd4cf16f75c73ad785a2f96fb97dbad4125a \
      --checkpoint-repo hkchengrex/Cutie \
      --checkpoint-revision v1.0 && \
    /opt/rpx-envs/cutie/bin/python -m compileall -q \
      /opt/rpx/benchmark/rpx_benchmark /opt/rpx/benchmark/scripts && \
    /opt/rpx-envs/cutie/bin/python -c \
      "import sys; sys.path.insert(0, '/opt/rpx/benchmark/scripts'); from tracking_models import TRACKER_CLASSES; assert sorted(TRACKER_CLASSES) == ['cutie', 'edgetam', 'sam2']; assert TRACKER_CLASSES['cutie'].model_revision == 'v1.0'"

WORKDIR /opt/rpx/benchmark
ENTRYPOINT []
