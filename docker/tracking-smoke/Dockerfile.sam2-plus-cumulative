# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG RPX_GIT_SHA

LABEL org.opencontainers.image.source="https://github.com/IRVLUTD/RPX" \
      org.opencontainers.image.revision="${RPX_GIT_SHA}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      org.opencontainers.image.description="Cumulative RPX D3 SAM2, EdgeTAM, Cutie, SAM2Long and SAM 2++ image"

ENV RPX_GIT_SHA=${RPX_GIT_SHA} \
    RPX_TRACKING_PYTHON=/opt/rpx-envs/sam2_plus/bin/python \
    SAM2_PLUS_CONFIG_DIR=/opt/rpx-models/sam2_plus/sam2_plus/configs/sam2.1 \
    PYTHONUNBUFFERED=1

COPY --chmod=0755 docker/tracking-smoke/register_model_env.py /usr/local/bin/rpx-register-model-env
COPY --chmod=0755 docker/tracking-smoke/stamp_adapter_env.py /usr/local/bin/rpx-stamp-adapter-env

ARG SAM2_PLUS_GIT_SHA=09c9ec4686d7170396ed98abcc0150f35e82c6b9
RUN test "${#RPX_GIT_SHA}" -eq 40 && \
    case "${RPX_GIT_SHA}" in \
      *[!0-9a-f]*) echo "RPX_GIT_SHA must be lowercase hexadecimal" >&2; exit 1 ;; \
      *) ;; \
    esac && \
    rpx-clone-pinned https://github.com/MCG-NJU/SAM2-Plus.git \
      "${SAM2_PLUS_GIT_SHA}" /opt/rpx-models/sam2_plus && \
    python -m venv --system-site-packages /opt/rpx-envs/sam2_plus && \
    SAM2_BUILD_CUDA=0 /opt/rpx-envs/sam2_plus/bin/python -m pip install \
      --no-deps --no-build-isolation /opt/rpx-models/sam2_plus && \
    /opt/rpx-envs/sam2_plus/bin/python /usr/local/bin/rpx-register-model-env \
      --model sam2-plus \
      --prompt box \
      --source-dir /opt/rpx-models/sam2_plus \
      --source-revision "${SAM2_PLUS_GIT_SHA}" \
      --checkpoint-repo MCG-NJU/SAM2-Plus \
      --checkpoint-revision c3c534e30469d8788123287a484488567c5115d4 \
      --import sam2 \
      --import sam2_plus \
      --import sam2_plus.sam2_video_predictor

COPY benchmark /opt/rpx/benchmark

RUN test -f "${SAM2_PLUS_CONFIG_DIR}/sam2.1_hiera_b+_predmasks_decoupled_MAME.yaml" && \
    /opt/rpx-envs/sam2_plus/bin/python -m pip install \
      --no-deps --force-reinstall /opt/rpx/benchmark && \
    /opt/rpx-envs/sam2_plus/bin/python /usr/local/bin/rpx-stamp-adapter-env \
      --model sam2-plus \
      --source-revision 09c9ec4686d7170396ed98abcc0150f35e82c6b9 \
      --checkpoint-repo MCG-NJU/SAM2-Plus \
      --checkpoint-revision c3c534e30469d8788123287a484488567c5115d4 && \
    /opt/rpx-envs/sam2_plus/bin/python -m compileall -q \
      /opt/rpx/benchmark/rpx_benchmark /opt/rpx/benchmark/scripts && \
    /opt/rpx-envs/sam2_plus/bin/python -c \
      "import sys; sys.path.insert(0, '/opt/rpx/benchmark/scripts'); from tracking_models import TRACKER_CLASSES; assert sorted(TRACKER_CLASSES) == ['cutie', 'edgetam', 'sam2', 'sam2-plus', 'sam2long']; assert TRACKER_CLASSES['sam2-plus'].model_revision == 'c3c534e30469d8788123287a484488567c5115d4'"

WORKDIR /opt/rpx/benchmark
ENTRYPOINT []
