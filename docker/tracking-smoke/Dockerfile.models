# syntax=docker/dockerfile:1.7

ARG SAM2_BASE_IMAGE=tracking_all_sam3_1
ARG SAM2_PLUS_BASE_IMAGE=tracking_all_sam2
ARG EDGETAM_BASE_IMAGE=tracking_all_sam2_plus
ARG DEAOT_BASE_IMAGE=tracking_all_edgetam
ARG CUTIE_BASE_IMAGE=tracking_all_deaot
ARG MOTIP_BASE_IMAGE=tracking_all_cutie
ARG MASA_BASE_IMAGE=tracking_all_motip
ARG GROUNDED_SAM2_BASE_IMAGE=tracking_all_masa

# The digest is the linux/amd64 manifest behind the named PyTorch image.
# A devel base is intentional: MOTIP and GroundingDINO contain official CUDA
# extensions. Checkpoints are never copied into an image.
FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-devel@sha256:3d614dfd422b7e43647491cbf07d6acc516c032fc49c594a94afdebd52552fb9 AS tracking_models_base

ARG RPX_GIT_SHA

LABEL org.opencontainers.image.title="RPX paper tracking model environments" \
      org.opencontainers.image.description="Cumulative, source-pinned environments for the RPX D3 tracker roster" \
      org.opencontainers.image.source="https://github.com/IRVLUTD/RPX" \
      org.opencontainers.image.revision="${RPX_GIT_SHA}"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/cache/huggingface \
    TORCH_HOME=/cache/torch \
    XDG_CACHE_HOME=/cache/xdg \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9+PTX" \
    MAX_JOBS=8 \
    RPX_GIT_SHA=${RPX_GIT_SHA}

RUN test -n "${RPX_GIT_SHA}" && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      ffmpeg \
      git \
      libgl1 \
      libglib2.0-0 \
      libgomp1 \
      ninja-build \
      procps && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/rpx-envs /opt/rpx-models /opt/rpx/benchmark \
      /cache/huggingface /cache/torch /cache/xdg

COPY docker/tracking-smoke/requirements-models.lock /tmp/requirements-models.lock
COPY --chmod=0755 docker/tracking-smoke/clone_pinned.sh /usr/local/bin/rpx-clone-pinned
COPY --chmod=0755 docker/tracking-smoke/register_model_env.py /usr/local/bin/rpx-register-model-env
COPY docker/tracking-smoke/model-matrix.json /opt/rpx/model-matrix.json
COPY benchmark /opt/rpx/benchmark

RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip==25.3 setuptools==80.9.0 wheel==0.45.1 && \
    python -m pip install -r /tmp/requirements-models.lock && \
    python -m pip install --no-deps --no-build-isolation /opt/rpx/benchmark && \
    python -m pip check

ARG TRACKEVAL_GIT_SHA=12c8791b303e0a0b50f753af204249e622d0281a
RUN rpx-clone-pinned https://github.com/JonathonLuiten/TrackEval.git \
      "${TRACKEVAL_GIT_SHA}" /opt/rpx-models/trackeval && \
    python -m pip install --no-deps --no-build-isolation /opt/rpx-models/trackeval && \
    python -c "from trackeval.metrics import CLEAR, HOTA, Identity; print(CLEAR, HOTA, Identity)"

WORKDIR /opt/rpx/benchmark


# 1. SAM 3.1 — official Meta repository and checkpoint revision.
FROM tracking_models_base AS tracking_all_sam3_1
ARG SAM3_GIT_SHA=6dbb02bd38288df755dfa1378000a861e65b84f6
RUN rpx-clone-pinned https://github.com/facebookresearch/sam3.git \
      "${SAM3_GIT_SHA}" /opt/rpx-models/sam3_1 && \
    python -m venv --system-site-packages /opt/rpx-envs/sam3_1 && \
    /opt/rpx-envs/sam3_1/bin/python -m pip install \
      --no-deps --no-build-isolation /opt/rpx-models/sam3_1 && \
    /opt/rpx-envs/sam3_1/bin/python /usr/local/bin/rpx-register-model-env \
      --model sam3.1 \
      --prompt mask \
      --source-dir /opt/rpx-models/sam3_1 \
      --source-revision "${SAM3_GIT_SHA}" \
      --checkpoint-repo facebook/sam3.1 \
      --checkpoint-revision daa63191845a41281374e725f4c9e51c7a824460 \
      --import sam3


# 2. SAM 2 — official Meta SAM 2.1 large checkpoint.
FROM ${SAM2_BASE_IMAGE} AS tracking_all_sam2
ARG RPX_GIT_SHA
ENV RPX_GIT_SHA=${RPX_GIT_SHA}
COPY --chmod=0755 docker/tracking-smoke/register_model_env.py /usr/local/bin/rpx-register-model-env
ARG SAM2_GIT_SHA=2b90b9f5ceec907a1c18123530e92e794ad901a4
RUN rpx-clone-pinned https://github.com/facebookresearch/sam2.git \
      "${SAM2_GIT_SHA}" /opt/rpx-models/sam2 && \
    python -m venv --system-site-packages /opt/rpx-envs/sam2 && \
    SAM2_BUILD_CUDA=0 /opt/rpx-envs/sam2/bin/python -m pip install \
      --no-deps --no-build-isolation /opt/rpx-models/sam2 && \
    /opt/rpx-envs/sam2/bin/python /usr/local/bin/rpx-register-model-env \
      --model sam2 \
      --prompt mask \
      --source-dir /opt/rpx-models/sam2 \
      --source-revision "${SAM2_GIT_SHA}" \
      --checkpoint-repo facebook/sam2-hiera-large \
      --checkpoint-revision e6a8e8809b8f1bfa2238b6d080f3d05cc76bd251 \
      --import sam2 \
      --import sam2.sam2_video_predictor


# 3. SAM 2++ — official Tracking Anything at Any Granularity implementation.
FROM ${SAM2_PLUS_BASE_IMAGE} AS tracking_all_sam2_plus
ARG RPX_GIT_SHA
ENV RPX_GIT_SHA=${RPX_GIT_SHA}
COPY --chmod=0755 docker/tracking-smoke/register_model_env.py /usr/local/bin/rpx-register-model-env
ARG SAM2_PLUS_GIT_SHA=09c9ec4686d7170396ed98abcc0150f35e82c6b9
RUN rpx-clone-pinned https://github.com/MCG-NJU/SAM2-Plus.git \
      "${SAM2_PLUS_GIT_SHA}" /opt/rpx-models/sam2_plus && \
    python -m venv --system-site-packages /opt/rpx-envs/sam2_plus && \
    SAM2_BUILD_CUDA=0 /opt/rpx-envs/sam2_plus/bin/python -m pip install \
      --no-deps --no-build-isolation /opt/rpx-models/sam2_plus && \
    /opt/rpx-envs/sam2_plus/bin/python /usr/local/bin/rpx-register-model-env \
      --model sam2-plus \
      --prompt box \
      --source-dir /opt/rpx-models/sam2_plus \
      --source-revision "${SAM2_PLUS_GIT_SHA}" \
      --checkpoint-repo MCG-NJU/SAM2-Plus \
      --checkpoint-revision c3c534e30469d8788123287a484488567c5115d4 \
      --prepend-source \
      --import sam2_plus


# 4. EdgeTAM — official Meta on-device tracker.
FROM ${EDGETAM_BASE_IMAGE} AS tracking_all_edgetam
ARG RPX_GIT_SHA
ENV RPX_GIT_SHA=${RPX_GIT_SHA}
COPY --chmod=0755 docker/tracking-smoke/register_model_env.py /usr/local/bin/rpx-register-model-env
ARG EDGETAM_GIT_SHA=7711e012a30a2402c4eaab637bdb00a521302c91
RUN rpx-clone-pinned https://github.com/facebookresearch/EdgeTAM.git \
      "${EDGETAM_GIT_SHA}" /opt/rpx-models/edgetam && \
    python -m venv --system-site-packages /opt/rpx-envs/edgetam && \
    SAM2_BUILD_CUDA=0 /opt/rpx-envs/edgetam/bin/python -m pip install \
      --no-deps --no-build-isolation /opt/rpx-models/edgetam && \
    /opt/rpx-envs/edgetam/bin/python /usr/local/bin/rpx-register-model-env \
      --model edgetam \
      --prompt mask \
      --source-dir /opt/rpx-models/edgetam \
      --source-revision "${EDGETAM_GIT_SHA}" \
      --checkpoint-repo facebook/EdgeTAM \
      --checkpoint-revision 14d7ecc48c656b94e5184519f698cd5386c5a2bf \
      --import sam2 \
      --import sam2.sam2_video_predictor


# 5. DeAOT — the official repository requires the correlation extension.
FROM ${DEAOT_BASE_IMAGE} AS tracking_all_deaot
ARG RPX_GIT_SHA
ENV RPX_GIT_SHA=${RPX_GIT_SHA}
COPY --chmod=0755 docker/tracking-smoke/register_model_env.py /usr/local/bin/rpx-register-model-env
ARG DEAOT_GIT_SHA=601c138435a1764eb01404f3495b914e6e2e8eca
ARG CORRELATION_GIT_SHA=4aa4431bf2f6057c9d40d4990227e3e655699ed3
COPY docker/tracking-smoke/patches/pytorch-correlation-torch27-openmp.patch \
     /tmp/pytorch-correlation-torch27-openmp.patch
RUN rpx-clone-pinned https://github.com/yoxu515/aot-benchmark.git \
      "${DEAOT_GIT_SHA}" /opt/rpx-models/deaot && \
    rpx-clone-pinned https://github.com/ClementPinard/Pytorch-Correlation-extension.git \
      "${CORRELATION_GIT_SHA}" /opt/rpx-models/deaot-correlation && \
    git -C /opt/rpx-models/deaot-correlation apply --check \
      /tmp/pytorch-correlation-torch27-openmp.patch && \
    git -C /opt/rpx-models/deaot-correlation apply \
      /tmp/pytorch-correlation-torch27-openmp.patch && \
    python -m venv --system-site-packages /opt/rpx-envs/deaot && \
    /opt/rpx-envs/deaot/bin/python -m pip install \
      --no-deps --no-build-isolation /opt/rpx-models/deaot-correlation && \
    /opt/rpx-envs/deaot/bin/python /usr/local/bin/rpx-register-model-env \
      --model deaot \
      --prompt mask \
      --source-dir /opt/rpx-models/deaot \
      --source-revision "${DEAOT_GIT_SHA}" \
      --import networks.models


# 6. Cutie — install the official minimal inference package, excluding GUI extras.
FROM ${CUTIE_BASE_IMAGE} AS tracking_all_cutie
ARG RPX_GIT_SHA
ENV RPX_GIT_SHA=${RPX_GIT_SHA}
COPY --chmod=0755 docker/tracking-smoke/register_model_env.py /usr/local/bin/rpx-register-model-env
ARG CUTIE_GIT_SHA=ec5cdd4cf16f75c73ad785a2f96fb97dbad4125a
ARG THINPLATE_GIT_SHA=f6995795397118b7d0ac01aecd3f39ffbfad9dee
RUN rpx-clone-pinned https://github.com/hkchengrex/Cutie.git \
      "${CUTIE_GIT_SHA}" /opt/rpx-models/cutie && \
    rpx-clone-pinned https://github.com/cheind/py-thin-plate-spline.git \
      "${THINPLATE_GIT_SHA}" /opt/rpx-models/thinplate && \
    python -m venv --system-site-packages /opt/rpx-envs/cutie && \
    /opt/rpx-envs/cutie/bin/python -m pip install \
      --no-deps --no-build-isolation /opt/rpx-models/thinplate && \
    /opt/rpx-envs/cutie/bin/python -m pip install \
      --no-deps --no-build-isolation /opt/rpx-models/cutie && \
    /opt/rpx-envs/cutie/bin/python /usr/local/bin/rpx-register-model-env \
      --model cutie \
      --prompt mask \
      --source-dir /opt/rpx-models/cutie \
      --source-revision "${CUTIE_GIT_SHA}" \
      --import cutie


# 7. MOTIP — compile its official multi-scale deformable-attention operation.
FROM ${MOTIP_BASE_IMAGE} AS tracking_all_motip
ARG RPX_GIT_SHA
ENV RPX_GIT_SHA=${RPX_GIT_SHA}
COPY --chmod=0755 docker/tracking-smoke/register_model_env.py /usr/local/bin/rpx-register-model-env
COPY docker/tracking-smoke/patches/motip-cuda-toolkit-build.patch \
     /tmp/motip-cuda-toolkit-build.patch
ARG MOTIP_GIT_SHA=14a4f2e4b96d7913899966ce7e70771f0ee7fc75
RUN rpx-clone-pinned https://github.com/MCG-NJU/MOTIP.git \
      "${MOTIP_GIT_SHA}" /opt/rpx-models/motip && \
    git -C /opt/rpx-models/motip apply --check \
      /tmp/motip-cuda-toolkit-build.patch && \
    git -C /opt/rpx-models/motip apply \
      /tmp/motip-cuda-toolkit-build.patch && \
    python -m venv --system-site-packages /opt/rpx-envs/motip && \
    cd /opt/rpx-models/motip/models/ops && \
    /opt/rpx-envs/motip/bin/python setup.py build_ext --inplace && \
    /opt/rpx-envs/motip/bin/python /usr/local/bin/rpx-register-model-env \
      --model motip \
      --prompt detector \
      --source-dir /opt/rpx-models/motip \
      --source-revision "${MOTIP_GIT_SHA}" \
      --checkpoint-repo MCG-NJU/MOTIP \
      --checkpoint-revision v0.1 \
      --prepend-source \
      --import models


# 8. MASA — preserve the authors' Torch 2.1/CUDA 11.8 OpenMMLab ABI in its
# own venv. This is intentionally the one large non-shared dependency layer.
FROM ${MASA_BASE_IMAGE} AS tracking_all_masa
ARG RPX_GIT_SHA
ENV RPX_GIT_SHA=${RPX_GIT_SHA}
COPY --chmod=0755 docker/tracking-smoke/register_model_env.py /usr/local/bin/rpx-register-model-env
COPY docker/tracking-smoke/requirements-masa-runtime.lock \
     /tmp/requirements-masa-runtime.lock
ARG MASA_GIT_SHA=c5472b9c7615f35abdf1188cb1a0c5408fe50d66
ARG MMDET_GIT_SHA=44ebd17b145c2372c4b700bfb9cb20dbd28ab64a
ARG SCALABEL_GIT_SHA=78b26be9800596a3c0c2a999f9e04deb8e3fc29a
ARG TETA_GIT_SHA=a62a9c0affec3a97f2cd0263141c53bcfb9c79f7
RUN rpx-clone-pinned https://github.com/siyuanliii/masa.git \
      "${MASA_GIT_SHA}" /opt/rpx-models/masa && \
    rpx-clone-pinned https://github.com/open-mmlab/mmdetection.git \
      "${MMDET_GIT_SHA}" /opt/rpx-models/mmdetection && \
    rpx-clone-pinned https://github.com/scalabel/scalabel.git \
      "${SCALABEL_GIT_SHA}" /opt/rpx-models/scalabel && \
    rpx-clone-pinned https://github.com/SysCV/tet.git \
      "${TETA_GIT_SHA}" /opt/rpx-models/tet && \
    python -m venv --system-site-packages /opt/rpx-envs/masa && \
    /opt/rpx-envs/masa/bin/python -m pip install \
      --index-url https://download.pytorch.org/whl/cu118 \
      torch==2.1.2+cu118 torchvision==0.16.2+cu118 && \
    /opt/rpx-envs/masa/bin/python -m pip install \
      mmengine==0.10.7 \
      mmcv==2.1.0 \
      --find-links https://download.openmmlab.com/mmcv/dist/cu118/torch2.1/index.html && \
    /opt/rpx-envs/masa/bin/python -m pip install \
      -r /tmp/requirements-masa-runtime.lock && \
    /opt/rpx-envs/masa/bin/python -m pip install \
      --no-deps --no-build-isolation /opt/rpx-models/mmdetection && \
    /opt/rpx-envs/masa/bin/python -m pip install \
      --no-deps --no-build-isolation /opt/rpx-models/tet/teta && \
    /opt/rpx-envs/masa/bin/python -m pip install \
      --no-deps --no-build-isolation /opt/rpx-models/scalabel && \
    /opt/rpx-envs/masa/bin/python -m pip install \
      --no-deps --no-build-isolation /opt/rpx-models/masa && \
    /opt/rpx-envs/masa/bin/python /usr/local/bin/rpx-register-model-env \
      --model masa \
      --prompt detector \
      --source-dir /opt/rpx-models/masa \
      --source-revision "${MASA_GIT_SHA}" \
      --import teta \
      --import scalabel \
      --import masa


# 9. Grounded-SAM2 — source-pinned text grounding + SAM 2 tracking stack.
FROM ${GROUNDED_SAM2_BASE_IMAGE} AS tracking_all_grounded_sam2
ARG RPX_GIT_SHA
ENV RPX_GIT_SHA=${RPX_GIT_SHA}
COPY --chmod=0755 docker/tracking-smoke/register_model_env.py /usr/local/bin/rpx-register-model-env
ARG GROUNDED_SAM2_GIT_SHA=b7a9c29f196edff0eb54dbe14588d7ae5e3dde28
RUN rpx-clone-pinned https://github.com/IDEA-Research/Grounded-SAM-2.git \
      "${GROUNDED_SAM2_GIT_SHA}" /opt/rpx-models/grounded_sam2 && \
    python -m venv --system-site-packages /opt/rpx-envs/grounded_sam2 && \
    SAM2_BUILD_CUDA=0 /opt/rpx-envs/grounded_sam2/bin/python -m pip install \
      --no-deps --no-build-isolation /opt/rpx-models/grounded_sam2 && \
    /opt/rpx-envs/grounded_sam2/bin/python -m pip install \
      --no-deps --no-build-isolation /opt/rpx-models/grounded_sam2/grounding_dino && \
    /opt/rpx-envs/grounded_sam2/bin/python /usr/local/bin/rpx-register-model-env \
      --model grounded-sam2 \
      --prompt text \
      --source-dir /opt/rpx-models/grounded_sam2 \
      --source-revision "${GROUNDED_SAM2_GIT_SHA}" \
      --python-path grounding_dino \
      --import groundingdino \
      --import sam2

ENV RPX_TRACKING_PYTHON=/opt/rpx-envs/grounded_sam2/bin/python
WORKDIR /opt/rpx/benchmark
VOLUME ["/cache/huggingface", "/cache/torch", "/outputs"]
ENTRYPOINT []
